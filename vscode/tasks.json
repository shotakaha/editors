{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zensical: serve",
      "type": "shell",
      "command": "uv run zensical serve",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "zensical: build",
      "type": "shell",
      "command": "uv run zensical build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "clasp: push",
      "type": "shell",
      "command": "clasp push",
      "problemMatcher": []
    },
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake --build build",
      "dependsOn": "cmake: configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
